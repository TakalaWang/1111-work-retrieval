{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1111-work-retrieval.invalid/schemas/runtime-manifest.schema.json",
  "title": "Work Retrieval Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "s3_key", "sha256", "size_bytes"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["embedding", "model", "index"]
          },
          "s3_key": {
            "type": "string",
            "pattern": "^runtime/[a-f0-9]{64}/[^/].+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
