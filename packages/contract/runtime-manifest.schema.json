{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1111-work-retrieval.invalid/schemas/runtime-manifest.schema.json",
  "title": "Work Retrieval Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^(embeddings|models|indexes)/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
          },
          {
            "not": {
              "pattern": "(^|/)\\.{1,2}(/|$)"
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sha256", "size_bytes"],
        "properties": {
          "kind": {
            "enum": ["embedding", "model", "index"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
