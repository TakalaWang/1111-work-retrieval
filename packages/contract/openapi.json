            },
            "maxItems": 10,
            "title": "Result",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "result"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SearchResultItem": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "pattern": "^[0-9]+$",
            "title": "Job Id",
            "type": "string"
          },
          "rank": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Rank",
            "type": "integer"
          }
        },
        "required": [
          "job_id",
          "rank"
        ],
        "title": "SearchResultItem",
        "type": "object"
      }
    }
  },
