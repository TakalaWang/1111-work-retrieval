            },
            "title": "Location Code",
            "type": "array"
          },
          "query": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "search_date": {
            "default": "2026-06-08",
            "format": "date",
            "title": "Search Date",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "result": {
            "items": {
